{
  "name": "backend",
  "version": "0.1.0",
  "description": "Backend de administración de empresa del rubro porcino",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-document-assets.js",
    "start": "node -r tsconfig-paths/register dist/src/index.js",
    "typecheck": "tsc --pretty -p tsconfig.json --skipLibCheck --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db": "docker-compose -f docker-compose-db.yml up -d",
    "db:stop": "docker-compose -f docker-compose-db.yml stop",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts --name",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:drop": "drizzle-kit drop --config=drizzle.config.ts",
    "db:seed": "ts-node --transpile-only -r tsconfig-paths/register src/shared/infra/database/seed.ts",
    "db:seed-permisos": "ts-node --transpile-only -r tsconfig-paths/register src/shared/infra/database/seed-permisos-no-regresion.ts"
  },
  "keywords": [
    "porcino",
    "granja",
    "express",
    "typescript",
    "hexagonal"
  ],
  "author": "Juan Jose Aranda",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "inversify": "^7.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.13.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/xml2js": "^0.4.14",
    "drizzle-kit": "^0.30.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
