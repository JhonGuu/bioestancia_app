# Entorno de ejecución
# Valores válidos: local | test | development | production
NODE_ENV=local

# Puerto del servidor HTTP
PORT=3000

# Secreto para firmar los JWT. En producción NO puede quedar en este valor de
# ejemplo — la app se niega a arrancar si NODE_ENV=production y este sigue
# siendo "change-me-to-a-long-random-string" (ver Env.validate()). Generá uno
# real con, por ejemplo, `openssl rand -base64 48`, y cargalo como secreto de
# la plataforma de hosting (nunca en el repo, ni siquiera en este archivo).
JWT_SECRET=change-me-to-a-long-random-string

# URL pública del frontend en producción — restringe a qué origen le
# responde CORS (ver ExpressAdapter). Obligatoria si NODE_ENV=production (la
# app no arranca sin ella); en local/development/test se ignora y CORS queda
# abierto. Ejemplo: https://bioestancia-app.vercel.app
FRONTEND_URL=

# URL de conexión a PostgreSQL
# Formato: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DB_URL=postgres://bioestancia:bioestancia@localhost:5442/bioestancia

# Salt rounds de bcrypt (cuanto más alto, más seguro pero más lento)
BCRYPT_SALT=10

# Nivel de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Credenciales para el contenedor docker de Postgres
POSTGRES_USER=bioestancia
POSTGRES_PASSWORD=bioestancia
POSTGRES_DB=bioestancia

# Opcionales — solo para `pnpm db:seed` (bootstrap inicial: crea Bioestancia y
# El Meridiano, y un admin con acceso a ambas). Sin esto, el seed solo crea las
# empresas.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Opcionales — completan cuit/teléfono/dirección de cada empresa al correr
# `pnpm db:seed` (se muestran en el encabezado del PDF de boleta). Es backfill:
# solo pisa lo que esté vacío, así que se puede correr el seed de nuevo cuando
# se quiera cargar/corregir estos datos.
SEED_BIOESTANCIA_CUIT=
SEED_BIOESTANCIA_TELEFONO=
SEED_BIOESTANCIA_DIRECCION=
SEED_EL_MERIDIANO_CUIT=
SEED_EL_MERIDIANO_TELEFONO=
SEED_EL_MERIDIANO_DIRECCION=

# ── AFIP (WSAA + WSLSP) ─────────────────────────────────────────────
# Opcionales: sin esto la app arranca igual, pero el endpoint de emitir CAE
# (POST /compras/:compraId/liquidacion/emitir-cae) devuelve 501 hasta que
# estén las 3 primeras cargadas. Requiere haber tramitado en AFIP el
# certificado digital del CUIT emisor y habilitado el servicio WSLSP.
# Ver apps/backend/src/shared/infra/afip/README.md.

# "homologacion" (testing) o "produccion". Default: homologacion.
AFIP_AMBIENTE=homologacion

# CUIT (sin guiones) del emisor, tal como figura en el certificado.
AFIP_CUIT=

# Rutas absolutas al certificado y clave privada del certificado AFIP.
AFIP_CERT_PATH=
AFIP_KEY_PATH=

# Punto de venta habilitado en AFIP para liquidaciones WSLSP.
AFIP_WSLSP_PUNTO_VENTA=

# Datos del "emisor" de la liquidación (Bioestancia como frigorífico) — fijos,
# se cargan una sola vez acá. Todos opcionales, pero sin ellos AFIP puede
# rechazar la liquidación. Ver apps/backend/src/shared/infra/afip/README.md.

# Carácter WSLSP de Bioestancia como emisor. 102 = "Matadero - Frigorífico"
# (ver WSLSP_CARACTER_PORCINO en wslsp.types.ts) es el valor esperable acá.
AFIP_EMISOR_COD_CARACTER=

# Fecha de inicio de actividades ante AFIP, formato YYYY-MM-DD.
AFIP_EMISOR_FECHA_INICIO_ACTIVIDADES=

# Número de inscripción en Ingresos Brutos.
AFIP_EMISOR_IIBB=

# Número de RUCA (Registro Único de Operadores de la Cadena Agroalimentaria).
AFIP_EMISOR_NRO_RUCA=

# Texto libre: lugar donde se realiza la operación (ej. "planta Bioestancia").
AFIP_LUGAR_REALIZACION=

# Código AFIP de localidad/provincia de destino (planta de Bioestancia) — la
# provincia usa la tabla WSLSP_PROVINCIAS (0-24) en wslsp.types.ts; la
# localidad depende de la provincia y hay que consultarla contra AFIP una vez
# que exista certificado (consultarLocalidadesPorProvincia).
AFIP_LOCALIDAD_DESTINO=
AFIP_PROVINCIA_DESTINO=

# Código de motivo de la liquidación (WSLSP_MOTIVO). Default: 1 (FAENA), que
# es el único caso de Bioestancia — normalmente no hace falta tocar esto.
AFIP_MOTIVO=
